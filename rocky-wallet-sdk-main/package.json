{
  "name": "@rocky-wallet/dapp-sdk",
  "version": "1.0.2",
  "description": "Rocky Wallet DApp SDK for connecting browser dApps to the Rocky Wallet extension.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "check": "node --check src/index.js",
    "prepack": "npm run build",
    "test": "node --test"
  },
  "keywords": [
    "rocky-wallet",
    "canton",
    "dapp",
    "wallet",
    "sdk"
  ],
  "license": "MIT"
}
